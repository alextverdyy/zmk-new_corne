     ___            &sk LCTRL        &sk LALT        &sk LGUI       &sk LSHFT       ___            ,           &kp PG_DN       NAV_LEFT        NAV_DOWN        NAV_RIGHT       &kp RET         ___            ,
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
     ___            ___             ___             &kp MAC_UNDO    &kp MAC_REDO    ___            ,           &kp INS         &kp TAB         ___             ___             ___             ___            ,
// ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
                                                    ___             ___             ___            ,           ___             CANCEL          ___            ,
                                                 //╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
                                                  // ╭───────────────┬───────────────┬───────────────╮
                                                                       ___                           ,
                                                  // ├───────────────┼───────────────┼───────────────┤
                                                      ___             ___             ___            ,
                                                  // ├───────────────┼───────────────┼───────────────┤
                                                      ___             ___                           ,
                                                  // ╰───────────────┴───────────────┴───────────────╯
&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
)

ZMK_BASE_LAYER(Fn,
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
