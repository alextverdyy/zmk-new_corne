ZMK_BASE_LAYER(Mouse,
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
     ___            ___             ___             ___             ___             ___            ,           ___             &kp PG_UP       U_MS_U          &kp PG_DN       ___             ___            ,
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
     ___            ___             ___             ___             ___             ___            ,           U_WH_L          U_MS_L          U_MS_D          U_MS_R          U_WH_R          ___            ,
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
     ___            ___             ___             ___             ___             ___            ,           ___             &mkp LCLK       &mkp MCLK       &mkp RCLK       ___             ___            ,
// ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
                                                    ___             ___             ___            ,           U_WH_U          U_WH_D          ___            ,
                                                 //╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
                                                  // ╭───────────────┬───────────────┬───────────────╮
                                                                      U_MS_U                        ,
                                                  // ├───────────────┼───────────────┼───────────────┤
                                                      U_MS_L          &mkp LCLK           U_MS_R    ,
                                                  // ├───────────────┼───────────────┼───────────────┤
                                                      &kp SPACE          U_MS_D                       ,
                                                  // ╰───────────────┴───────────────┴───────────────╯
&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
)

ZMK_BASE_LAYER(Numsym,
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        ___           ___           &kp N7              &kp N8        &kp N9        &kp STAR       ,            &kp EXCL      &kp LBKT        &kp RBKT        &kp DLLR         &kp PIPE             ___       ,
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        ___           &sk LCTRL      &hml LALT N4     &hml LGUI N5   &hml LSHFT N6   &kp FSLH      ,            &kp AT        &hml LSHFT LPAR &hml LGUI RPAR  &hml LALT PRCNT &hml LCTRL AMPS  &kp GRAVE      ,
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        ___           ___             &kp N1          &kp N2         &kp N3         &kp DOT        ,            &kp HASH      &kp LBRC        &kp RBRC        &kp CARET        &kp BSLH             ___       ,
// ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
                                                             ___      &kp N0             ___       ,                ___           ___           ___         ,
                                                 //╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
                                                  // ╭───────────────┬───────────────┬───────────────╮
                                                                      U_MS_U                        ,
                                                  // ├───────────────┼───────────────┼───────────────┤
                                                      U_MS_L          &mkp LCLK           U_MS_R    ,
                                                  // ├───────────────┼───────────────┼───────────────┤
                                                      &kp SPACE          U_MS_D                       ,
                                                  // ╰───────────────┴───────────────┴───────────────╯
&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
)


ZMK_BASE_LAYER(Buttons,
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        &none       &kp MAC_DKTP &kp MAC_WINP  &kp MAC_WINN      &kp MAC_DKTN   &kp MAC_APPWIN,  		&kp MAC_APPWIN &kp MAC_DKTP  &kp MAC_WINP  &kp MAC_WINN  &kp MAC_DKTN &kp RG(PLUS),
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   	      ┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        &none       &kp LCTRL    &kp LALT     &kp LGUI           &kp LSHFT     &kp MAC_MC,      		&kp MAC_MC     &kp LSHFT     &kp LGUI        &kp LALT         &kp LCTRL    &kp RG(MINUS),
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   	      ┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
   &mt GLOBE MAC_REDO UNDO_TOG_BUT_LAYER    &kp MAC_CUT   &kp MAC_COPY   &kp MAC_PASTE    &kp MAC_SP,    	&kp MAC_SP     &kp MAC_PASTE &kp MAC_COPY  &kp MAC_CUT   UNDO_TOG_BUT_LAYER  &mt GLOBE MAC_REDO,
// ╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
                                                             ___      ___             ___       ,                ___           ___           ___         ,
                                                 //╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
                                                  // ╭───────────────┬───────────────┬───────────────╮
                                                                      U_MS_U                        ,
                                                  // ├───────────────┼───────────────┼───────────────┤
                                                      U_MS_L          &mkp LCLK           U_MS_R    ,
                                                  // ├───────────────┼───────────────┼───────────────┤
                                                      &kp SPACE          U_MS_D                       ,
                                                  // ╰───────────────┴───────────────┴───────────────╯
&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
)
